PATCHWISE_ENV=development
PATCHWISE_HOST=0.0.0.0
PATCHWISE_PORT=8000
PATCHWISE_DEFAULT_MODEL=gpt-4o
PATCHWISE_MAX_ROUNDS=5
PATCHWISE_DB_URL=sqlite:///./data/patchwise.db
PATCHWISE_CHROMA_HOST=localhost
PATCHWISE_CHROMA_PORT=8001

# Unified LLM runtime config (used by app/agents)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
QUALCOMM_API_KEY=
