# ============================
# PatchWise Configuration
# ============================

# App port (single unified port - default 7000)
# If 7000 is busy, run.sh auto-increments to 7001, 7002...
APP_PORT=7000

# LLM Configuration
# Provider controls which remote agent backend is used.
# Supported: openai | anthropic | mock | qualcomm
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
# Generic fallback key (used when provider-specific key is not set)
LLM_API_KEY=
# Provider-specific keys (preferred over LLM_API_KEY)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
QUALCOMM_API_KEY=
# You can also set/update keys from UI: /settings

# Agent Configuration
CHANAKYA_MAX_ROUNDS=5        # Max review-fix iterations (1-10)
SUBSYSTEM=audio              # Kernel subsystem focus

# Knowledge Base
LKML_PRESEEDED=false         # Set true after running: ./run.sh seed

# GitHub Integration
GITHUB_TOKEN=
GITHUB_REPO=nandamajay/patchwise

# Gerrit Integration
GERRIT_URL=
GERRIT_USERNAME=
GERRIT_PASSWORD=

# Email Notifications
SMTP_HOST=localhost
NOTIFY_EMAIL=nandam@qti.qualcomm.com

# Internal paths (do not change)
CHROMADB_PATH=/app/data/chromadb
SQLITE_PATH=/app/data/sqlite/patchwise.db
PATCHES_PATH=/app/data/patches
