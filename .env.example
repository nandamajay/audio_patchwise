# ── Ports (auto-managed by run.sh) ──
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ── LLM Configuration ──
LLM_PROVIDER=openai           # openai | anthropic | qualcomm
OPENAI_API_KEY=your_key_here
ANTHROPIC_API_KEY=your_key_here
QUALCOMM_API_KEY=your_key_here
QUALCOMM_API_BASE=https://your-internal-endpoint

# ── ChromaDB ──
CHROMA_DB_PATH=./data/chromadb
CHROMA_COLLECTION_AUDIO=patchwise_audio_asoc

# ── SQLite ──
SQLITE_DB_PATH=./data/sqlite/patchwise.db

# ── PatchWise Skill ──
CHECKPATCH_PATH=/usr/local/bin/checkpatch.pl
LKML_SEARCH_BASE=https://lore.kernel.org/alsa-devel/

# ── GitHub / Gerrit ──
GITHUB_TOKEN=your_token_here
GERRIT_BASE_URL=https://your-gerrit-instance
GERRIT_USERNAME=your_username
GERRIT_HTTP_PASSWORD=your_password

# ── Agent Config Defaults ──
MAX_REVIEW_ROUNDS=5
DEFAULT_SUBSYSTEM=audio
STREAMING_ENABLED=true
