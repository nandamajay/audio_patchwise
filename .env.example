# ============================
# PatchWise Configuration
# ============================

# App port (single unified port - default 7000)
# If 7000 is busy, run.sh auto-increments to 7001, 7002...
APP_PORT=7000

# ============================================================
# QGENIE CONFIGURATION (Primary — Recommended)
# ============================================================
QGENIE_API_KEY=your-qgenie-api-key-here
QGENIE_BASE_URL=https://qgenie-chat.qualcomm.com/v1
QGENIE_DEFAULT_MODEL=gpt-4o

# PatchWise Skill via QGenie
PATCHWISE_PROVIDER=https://qgenie-chat.qualcomm.com/v1
PATCHWISE_REVIEWS=checkpatch,ai_code_review

# ============================================================
# FALLBACK LLM CONFIGURATION (Optional — if QGenie unavailable)
# ============================================================
OPENAI_API_KEY=your-openai-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here

# ============================================================
# ACTIVE LLM PROVIDER (qgenie | openai | anthropic)
# ============================================================
LLM_PROVIDER=qgenie
LLM_MODEL=gpt-4o

# Agent Configuration
CHANAKYA_MAX_ROUNDS=5        # Max review-fix iterations (1-10)
SUBSYSTEM=audio              # Kernel subsystem focus

# Knowledge Base
LKML_PRESEEDED=false         # Set true after running: ./run.sh seed

# GitHub Integration
GITHUB_TOKEN=
GITHUB_REPO=nandamajay/patchwise

# Gerrit Integration
GERRIT_URL=
GERRIT_USERNAME=
GERRIT_PASSWORD=

# Email Notifications
SMTP_HOST=localhost
NOTIFY_EMAIL=nandam@qti.qualcomm.com

# Internal paths (do not change)
CHROMADB_PATH=/app/data/chromadb
SQLITE_PATH=/app/data/sqlite/patchwise.db
PATCHES_PATH=/app/data/patches

# Scheduler
SEED_SCHEDULE=every_sunday_night
# Options: every_sunday_night | every_day_midnight | every_6_hours | every_hour | manual_only

# Concurrency
MAX_CONCURRENT_SESSIONS=10
DB_BUSY_TIMEOUT_MS=5000

# Review noise control
# false = include only checkpatch ERROR/WARNING in STYLE findings
# true  = include CHECK-level advisories too
PATCHWISE_INCLUDE_CHECKPATCH_CHECKS=false

# ============================================================
# Dev-Compute SSH Configuration
# ============================================================
# Reference AKDW:
# /local/mnt/workspace/AKDW/Audio_Kernel_Development_Workbench
DEV_COMPUTE_HOST=hu-nandam-hyd
DEV_COMPUTE_USER=nandam
DEV_COMPUTE_SSH_KEY=/run/secrets/ssh_private_key
DEV_COMPUTE_SSH_KEY_PATH=/run/secrets/ssh_private_key
DEV_COMPUTE_ENABLED=true
DEV_COMPUTE_KERNEL_PATH=/local/mnt/workspace/upstream_patches/xo_sd_LPI/linux-next
DEV_COMPUTE_PATCHWISE_BIN=/home/nandam/.local/bin/patchwise
DEV_COMPUTE_PATCHWISE_PATH=/home/nandam/.local/bin/patchwise
DEV_COMPUTE_FALLBACK_MODE=docker_local

# Screen session settings
SCREEN_SESSION_PREFIX=pw
SCREEN_CLEANUP_ON_COMPLETE=true

# SSH resilience
SSH_RECONNECT_MAX_ATTEMPTS=3
SSH_RECONNECT_BACKOFF_SECONDS=5,15,30
SSH_HEARTBEAT_INTERVAL=30
SSH_KEEPALIVE_INTERVAL=30

# Fallback behavior
SSH_FALLBACK_TO_LOCAL=true
SSH_FALLBACK_NOTIFY_USER=true
