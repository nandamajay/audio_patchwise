{
  "required_status_checks": {
    "strict": true,
    "contexts": [
      "🔍 Backend — Lint & Type Check",
      "🧪 Backend — Unit Tests",
      "🛠️ PatchWise Skill — Integration Tests",
      "🎨 Frontend — Lint & Type Check",
      "🏗️ Frontend — Build",
      "🐳 Docker — Build Validation",
      "✅ CI Gate — All Checks Passed"
    ]
  },
